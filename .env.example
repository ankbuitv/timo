# ============================================================================
# TIMO – Mẫu biến môi trường (KHÔNG chứa giá trị thật)
# Sao chép sang file cục bộ đã được git ignore: .env / .dev.vars
# ----------------------------------------------------------------------------
# Quy ước đặt tên:
#   VITE_*     → được đưa vào bundle trình duyệt. CHỈ dùng cho giá trị CÔNG KHAI.
#   (không có tiền tố) → chỉ tồn tại phía Worker. Bí mật đặt bằng `wrangler secret put`.
# ============================================================================

# ---- Tên miền (cấu hình được; có thể dùng workers.dev khi thử nghiệm) ----
PUBLIC_APP_URL=https://timovn.dpdns.org
PUBLIC_SUPPORT_URL=https://support.timovn.dpdns.org
PUBLIC_STATUS_URL=https://status.timovn.dpdns.org
# Fallback thử nghiệm: https://timo-api.<subdomain>.workers.dev

# ---- Supabase Auth / Storage ----
SUPABASE_URL=https://<project-ref>.supabase.co
# Khóa anon: công khai, dùng cho trình duyệt VÀ cho Worker (wrangler var SUPABASE_ANON_KEY)
# để gọi GET /auth/v1/user khi bootstrap quản trị viên (kiểm tra email đã xác minh).
SUPABASE_ANON_KEY=
# CHƯA SỬ DỤNG trong mã hiện tại. KHÔNG đặt giá trị cho đến khi có tính năng Storage phía server
# được duyệt. Nếu cần: wrangler secret put SUPABASE_SERVICE_ROLE_KEY (không bao giờ vào VITE_*).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Ollama Cloud (giai đoạn 6, CHƯA triển khai) ----
# Kế hoạch: API key Ollama được nhập qua giao diện quản trị, mã hóa AES-256-GCM và lưu dạng
# ciphertext trong D1. Khóa mã hóa là BÍ MẬT Worker: wrangler secret put TIMO_AI_ENCRYPTION_KEY
# (32 byte ngẫu nhiên, base64). KHÔNG đặt OLLAMA_API_KEY ở đây; biến này hiện không được đọc.
# Danh sách host được phép: AI_ALLOWED_HOSTS (mặc định ollama.com).

# ---- Cloudflare (chỉ dùng trong CI/CD hoặc máy vận hành) ----
CLOUDFLARE_ACCOUNT_ID=
# BÍ MẬT – token có quyền tối thiểu cho Workers + D1. Lưu trong GitHub Environment secrets.
CLOUDFLARE_API_TOKEN=

# ---- Khởi tạo quản trị viên đầu tiên ----
INITIAL_ADMIN_EMAIL=
# BÍ MẬT – ít nhất 32 ký tự ngẫu nhiên. Đặt bằng: wrangler secret put SETUP_SECRET
SETUP_SECRET=

# ---- Môi trường & CORS ----
# staging/production: rate limit fail-closed (cần binding SENSITIVE_RATE_LIMITER), origin phải https.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
