{
  "name": "@timo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --ip 0.0.0.0",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply timo-main --local",
    "migrate:staging": "wrangler d1 migrations apply timo-main-staging --remote --env staging",
    "migrate:production": "wrangler d1 migrations apply timo-main --remote --env production"
  },
  "dependencies": {
    "@timo/auth": "workspace:*",
    "@timo/database": "workspace:*",
    "@timo/shared": "workspace:*",
    "@timo/validation": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "jose": "^6.2.12",
    "vitest": "^3.2.7",
    "wrangler": "^4.148.0"
  }
}
