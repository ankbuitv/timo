# Biến VITE_* được đưa vào bundle trình duyệt. KHÔNG đặt bí mật ở đây.
# Để trống VITE_API_BASE_URL = cùng origin, gọi /api (khuyến nghị).
VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Khóa anon (công khai). KHÔNG dùng service_role.
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_PUBLIC_SUPPORT_URL=
VITE_PUBLIC_STATUS_URL=
VITE_APP_ENV=development

# ---- Liên kết tùy chọn ở chân trang (để trống thì mục tương ứng được ẩn) ----
VITE_PUBLIC_REPOSITORY_URL=
VITE_PUBLIC_SUPPORT_EMAIL=
